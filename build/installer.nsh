!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Conheca o Bronx I.A"
  !define MUI_WELCOMEPAGE_TEXT "JUNGLER TRACKER: última posição observada no minimapa e contexto da partida.$\r$\nFLASH TIMING: timers de Flash marcados no chat para qualquer campeão inimigo.$\r$\nOBJETIVOS: previsões por cronômetro, overlay no jogo e alertas de voz.$\r$\n$\r$\nVocê inicia a captura. O app não lê a memória do jogo nem automatiza comandos.$\r$\n$\r$\nClique em Avançar para escolher onde instalar."
  !insertmacro MUI_PAGE_WELCOME
!macroend
