{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bronx-riot-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "SYNC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
